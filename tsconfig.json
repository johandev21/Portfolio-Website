{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".astro/types.d.ts", "src", "scripts"],
  "exclude": ["dist", "dist-baseline-react"]
}

---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="mx-auto flex w-full max-w-full flex-col items-stretch px-3 pt-10 md:px-8 md:pt-14 lg:px-0">
    <div>
      <section class="mx-auto w-full max-w-2xl pb-24">
        <p class="font-mono text-xs tracking-[0.08em] text-muted uppercase">404</p>
        <h1 class="mt-3 font-serif text-4xl text-text md:text-5xl">
          Proyecto no encontrado
        </h1>
        <p class="mt-4 max-w-xl leading-7 text-text-soft">
          El proyecto que buscas no existe o cambió de dirección.
        </p>
        <a
          href="/#proyectos"
          class="focus-link mt-8 inline-block rounded-none text-sm font-medium text-accent underline underline-offset-4 transition-motion motion-reduce:transition-none"
        >
          Volver a proyectos
        </a>
      </section>
    </div>
  </div>
</Layout>
